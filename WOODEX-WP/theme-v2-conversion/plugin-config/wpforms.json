{
  "name":"Woodex Free Consultation Form",
  "slug":"woodex-free-consultation",
  "fields":[
    {"name":"Full name","type":"text","required":true},
    {"name":"Email","type":"email","required":true},
    {"name":"WhatsApp / phone","type":"phone","required":true},
    {"name":"City","type":"text","required":true},
    {"name":"Project type","type":"select","options":["Residential","Commercial","Office","Retail","Hospitality","Fit-Out","Joinery","Other"]},
    {"name":"Service needed","type":"select","source":"services.json"},
    {"name":"Approximate area","type":"text","required":false},
    {"name":"Timeline","type":"select","options":["Planning now","Within 1 month","1–3 months","3–6 months","Not sure"]},
    {"name":"Budget range","type":"text","required":false},
    {"name":"Message","type":"textarea","required":true},
    {"name":"Floor plan","type":"file","accept":["pdf","jpg","jpeg","png"],"required":false},
    {"name":"Consent","type":"checkbox","required":true}
  ],
  "confirmation":{"type":"redirect","url":"/thank-you/"},
  "notifications":{"recipient":"PENDING_APPROVAL","subject":"New Woodex consultation enquiry"},
  "spamProtection":{"honeypot":true,"captcha":"PENDING_APPROVAL"}
}
