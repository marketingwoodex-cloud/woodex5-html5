---
/**
 * WX DOC GRID — "How a room is documented".
 * ---------------------------------------------------------------------------
 * Three columns: the argument, the drawing, and the three things a client is
 * actually buying (interior design, consultation, 3D visualization). The main
 * image carries a soft mouse tilt on desktop and a small floating still — the
 * "approved still, then sheets" idea, shown rather than stated.
 */
import Btn from '../components/ui/Btn.astro';
import Icon from '../components/ui/Icon.astro';
import { doc } from '../data/home.js';

const { eyebrow, title, lede, cta, float, main, cards } = doc;
---

<section class="dg">
  <div class="container dg__grid">
    <div class="dg__copy" data-reveal="fade-up">
      <p class="dg__eyebrow"><i aria-hidden="true"></i>{eyebrow}</p>
      <h2 data-heading-reveal="words" data-heading-stagger="48">{title}</h2>
      <p class="dg__lede">{lede}</p>
      <Btn href={cta.href} label={cta.label} variant="dark" />
      <div class="dg__float">
        <img src={float.image} alt={float.alt} width="1408" height="768" loading="lazy" data-tone="none" />
      </div>
    </div>

    <div class="dg__main" data-reveal="fade-up" style="--reveal-delay:90ms" data-tilt>
      <img src={main.image} alt={main.alt} width="1408" height="768" loading="lazy" data-tone="none" />
    </div>

    <div class="dg__cards">
      {cards.map((c, i) => (
        <article class="dg__card" data-reveal="fade-up" style={`--reveal-delay:${i * 90}ms`}>
          <span class="dg__ico" aria-hidden="true"><Icon name={c.icon} size={22} stroke={1.5} /></span>
          <h3>{c.title}</h3>
          <p>{c.copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .dg {
    padding-block: clamp(4.5rem, 9vw, 8.5rem);
    background: var(--c-cream);
    color: var(--c-ink);
  }
  .dg__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-areas:
      'copy main'
      'copy cards';
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }
  .dg__copy { grid-area: copy; position: relative; }
  .dg__main { grid-area: main; }
  .dg__cards {
    grid-area: cards;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-md, 16px);
    overflow: hidden;
  }

  .dg__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .dg__eyebrow i { width: 22px; height: 1px; background: var(--c-wood, #b8956a); flex: none; }
  .dg h2 {
    margin: 0 0 1.1rem;
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    font-weight: 500;
    line-height: 1.07;
    letter-spacing: -0.038em;
    max-width: 16ch;
  }
  .dg__lede {
    margin: 0 0 1.75rem;
    max-width: 46ch;
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--c-muted);
  }

  /* Floating still — overlaps the copy column, so it is hidden on small
     screens where there is no room for the overlap to read. */
  .dg__float {
    position: absolute;
    right: -8%;
    bottom: -3rem;
    width: min(52%, 15rem);
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md, 16px);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(12, 22, 40, 0.22);
    border: 5px solid var(--c-cream);
  }
  .dg__float img { width: 100%; height: 100%; object-fit: cover; }

  .dg__main {
    position: relative;
    aspect-ratio: 4 / 2.9;
    border-radius: var(--r-lg, 24px);
    overflow: hidden;
    background: var(--c-navy);
    transition: transform 0.6s var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
    will-change: transform;
  }
  .dg__main img { width: 100%; height: 100%; object-fit: cover; }

  /* ── Cards ────────────────────────────────────────────────────────────── */
  .dg__card {
    padding: clamp(1.15rem, 2vw, 1.6rem);
    background: var(--c-white);
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .dg__ico {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--c-cream);
    color: var(--c-navy);
    margin-bottom: 4px;
  }
  .dg__card h3 {
    margin: 0;
    font-size: 1.06rem;
    font-weight: 600;
    letter-spacing: -0.024em;
  }
  .dg__card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--c-muted);
  }

  @media (max-width: 1024px) {
    .dg__grid {
      grid-template-columns: 1fr;
      grid-template-areas: 'copy' 'main' 'cards';
    }
    .dg__float { position: static; width: 100%; aspect-ratio: 4 / 2.4; margin-top: 1.75rem; border-width: 0; box-shadow: none; }
    .dg__main { aspect-ratio: 4 / 2.8; }
  }
  @media (max-width: 720px) {
    .dg__cards { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dg__main { transition: none; }
  }
</style>
