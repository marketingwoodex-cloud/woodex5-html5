---
/**
 * SECTION · Journal Grid                      [ journal-grid ]
 * ---------------------------------------------------------------------------
 * Article index in three layouts, plus an optional topic filter bar.
 *   variant="feature"  → one large hero article + supporting list
 *   variant="grid"     → uniform three-up cards
 *   variant="list"     → editorial rows with a date rail
 *
 * MOTION: staggered reveal · clip image reveal · hover zoom
 */
import Icon from '../components/ui/Icon.astro';
import { articles, topics, formatDate } from '../data/articles.js';
import Img from '../components/ui/Img.astro';


interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  variant?: 'feature' | 'grid' | 'list';
  limit?: number;
  showFilter?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
  theme?: 'default' | 'dark' | 'gray';
}

const {
  eyebrow = 'The journal',
  title = 'Insights for resilient, well-built interiors',
  lede = 'Practical guidance on designing, costing and building interiors in Pakistan.',
  variant = 'feature',
  limit = 7,
  showFilter = true,
  ctaLabel = 'Read all articles',
  ctaHref = '/journal',
  theme = 'default',
} = Astro.props;

const all = articles.slice(0, limit);
const [hero, ...rest] = all;
---

<section class:list={['journal-grid', 'section']} data-theme={theme}>
  <div class="container">
    <div class="sec-head">
      <div class="sec-head__text">
        <span class="eyebrow" data-reveal="fade">{eyebrow}</span>
        <h2 data-heading-reveal="words" data-heading-stagger="50">{title}</h2>
      </div>
      <p class="sec-head__aside" data-reveal="fade-up" style="--reveal-delay:180ms">{lede}</p>
    </div>

    {showFilter && (
      <div class="pill-group jg__filter" data-reveal="fade-up" role="tablist" aria-label="Filter journal by topic">
        <a class="pill is-active" href={ctaHref}>All</a>
        {topics.map((t) => (
          <a class="pill" href={`${ctaHref}?topic=${t.id}`}>{t.label}</a>
        ))}
      </div>
    )}

    <!-- ══ FEATURE VARIANT ═════════════════════════════════════════════ -->
    {variant === 'feature' && hero && (
      <div class="jg-feature">
        <article class="jg-hero" data-reveal="clip">
          <a href={`/blog/${hero.slug}`} class="jg-hero__link" data-cursor="Read">
            <div class="jg-hero__media">
              <Img src={hero.cover} alt={hero.title} loading="lazy" width="1200" height="800" />
            </div>
            <div class="jg-hero__body">
              <div class="card__meta">
                <span class="tag">{topics.find((t) => t.id === hero.topic)?.label ?? hero.topic}</span>
                <span>{formatDate(hero.date)}</span>
                <span>{hero.readingTime} min read</span>
              </div>
              <h3 class="jg-hero__title">{hero.title}</h3>
              <p class="jg-hero__excerpt">{hero.excerpt}</p>
              <span class="text-link">
                Read article <Icon name="arrow-right" size={14} class="arrow" />
              </span>
            </div>
          </a>
        </article>

        <div class="jg-side" data-stagger="90">
          {rest.slice(0, 4).map((a) => (
            <article class="jg-mini" data-reveal="fade-up">
              <a href={`/blog/${a.slug}`}>
                <div class="jg-mini__media">
                  <Img src={a.cover} alt="" loading="lazy" width="320" height="240" />
                </div>
                <div class="jg-mini__body">
                  <span class="jg-mini__meta">{formatDate(a.date)} · {a.readingTime} min</span>
                  <h3 class="jg-mini__title">{a.title}</h3>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    )}

    <!-- ══ GRID VARIANT ════════════════════════════════════════════════ -->
    {variant === 'grid' && (
      <div class="jg-grid" data-stagger="100">
        {all.map((a) => (
          <article class="card jg-card" data-reveal="fade-up">
            <a href={`/blog/${a.slug}`}>
              <div class="card__media ratio-3-2">
                <Img src={a.cover} alt="" loading="lazy" width="800" height="533" />
                <span class="jg-card__tag">{topics.find((t) => t.id === a.topic)?.label ?? a.topic}</span>
              </div>
              <div class="card__body">
                <div class="card__meta">
                  <span>{formatDate(a.date)}</span>
                  <span>·</span>
                  <span>{a.readingTime} min read</span>
                </div>
                <h3 class="card__title">{a.title}</h3>
                <p class="card__excerpt">{a.excerpt}</p>
                <div class="card__foot">
                  <span class="jg-card__author">
                    <Img src="/images/people/avatar-01.jpg" alt="" width="28" height="28" />
                    {a.author}
                  </span>
                  <Icon name="arrow-up-right" size={15} class="arrow-up-right" />
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}

    <!-- ══ LIST VARIANT ════════════════════════════════════════════════ -->
    {variant === 'list' && (
      <div class="jg-list" data-stagger="70">
        {all.map((a) => (
          <article class="jg-row" data-reveal="fade-up">
            <a href={`/blog/${a.slug}`}>
              <time class="jg-row__date" datetime={a.date}>
                <strong>{new Date(a.date).getDate()}</strong>
                <span>{new Date(a.date).toLocaleDateString('en-GB', { month: 'short' })}</span>
                <em>{new Date(a.date).getFullYear()}</em>
              </time>

              <div class="jg-row__media">
                <Img src={a.cover} alt="" loading="lazy" width="480" height="360" />
              </div>

              <div class="jg-row__body">
                <span class="tag">{topics.find((t) => t.id === a.topic)?.label ?? a.topic}</span>
                <h3 class="jg-row__title">{a.title}</h3>
                <p class="jg-row__excerpt">{a.excerpt}</p>
                <div class="jg-row__meta">
                  <span>{a.author}</span>
                  <span>·</span>
                  <span>{a.readingTime} min read</span>
                </div>
              </div>

              <span class="jg-row__arrow" aria-hidden="true">
                <Icon name="arrow-up-right" size={16} stroke={1.8} />
              </span>
            </a>
          </article>
        ))}
      </div>
    )}

    <div class="journal-grid__foot" data-reveal="fade-up">
      <a href={ctaHref} class="btn btn--ghost btn--lg">
        <span class="btn__label"><span>{ctaLabel}</span></span>
        <Icon name="arrow-right" size={15} class="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .jg__filter { margin-bottom: 2.5rem; }

  .journal-grid__foot { display: flex; justify-content: center; margin-top: 3rem; }

  /* ══ Feature ═══════════════════════════════════════════════════════ */
  .jg-feature {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .jg-hero { border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--line); background: var(--bg-card); }

  .jg-hero__media { aspect-ratio: 16 / 10; overflow: hidden; }
  .jg-hero__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-expo); }
  .jg-hero:hover .jg-hero__media img { transform: scale(1.05); }

  .jg-hero__body { padding: clamp(1.5rem, 2.6vw, 2.25rem); }
  .jg-hero__title { font-size: clamp(1.5rem, 2.6vw, 2.15rem); line-height: 1.16; letter-spacing: -0.028em; margin-top: 1rem; }
  .jg-hero__excerpt { margin-top: 1rem; color: var(--text-soft); max-width: 54ch; }
  .jg-hero__body :global(.text-link) { margin-top: 1.5rem; }

  .jg-side { display: flex; flex-direction: column; }

  .jg-mini { border-bottom: 1px solid var(--line); }
  .jg-mini:first-child { border-top: 1px solid var(--line); }

  .jg-mini a {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1.15rem;
    align-items: center;
    padding: 1.15rem 0;
    transition: padding var(--dur-slow) var(--ease-expo);
  }

  .jg-mini a:hover { padding-inline-start: 0.5rem; }

  .jg-mini__media { aspect-ratio: 4 / 3; border-radius: var(--r-sm); overflow: hidden; background: var(--bg-soft); }
  .jg-mini__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-expo); }
  .jg-mini a:hover .jg-mini__media img { transform: scale(1.08); }

  .jg-mini__meta { font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-mute); }
  .jg-mini__title { font-size: 1rem; line-height: 1.35; letter-spacing: -0.012em; margin-top: 0.5rem; }

  /* ══ Grid ══════════════════════════════════════════════════════════ */
  .jg-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }

  .jg-card :global(.card__media) { position: relative; }
  .jg-card :global(a) { display: flex; flex-direction: column; height: 100%; }

  .jg-card__tag {
    position: absolute;
    inset-block-start: 0.85rem;
    inset-inline-start: 0.85rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--r-pill);
    background: rgba(252, 242, 232, 0.92);
    color: var(--c-jet);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }

  .jg-card__author { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; color: var(--text-mute); }
  .jg-card__author img { width: 1.75rem; height: 1.75rem; border-radius: 50%; object-fit: cover; }

  /* ══ List ══════════════════════════════════════════════════════════ */
  .jg-list { border-top: 1px solid var(--line); }

  .jg-row { border-bottom: 1px solid var(--line); }

  .jg-row a {
    display: grid;
    grid-template-columns: 4rem 11rem minmax(0, 1fr) auto;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: center;
    padding: clamp(1.25rem, 2.4vw, 2rem) 0;
    transition: padding var(--dur-slow) var(--ease-expo), background var(--dur) var(--ease-out);
  }

  .jg-row a:hover { padding-inline: 1rem; background: var(--bg-soft); }

  .jg-row__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05rem;
    font-variant-numeric: tabular-nums;
  }

  .jg-row__date strong { font-family: var(--ff-display); font-size: 1.75rem; line-height: 1; font-weight: 500; letter-spacing: -0.03em; }
  .jg-row__date span { font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-mute); }
  .jg-row__date em { font-style: normal; font-size: 0.625rem; color: var(--text-mute); }

  .jg-row__media { aspect-ratio: 4 / 3; border-radius: var(--r-sm); overflow: hidden; background: var(--bg-soft); }
  .jg-row__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-expo); }
  .jg-row a:hover .jg-row__media img { transform: scale(1.07); }

  .jg-row__body { display: flex; flex-direction: column; gap: 0.6rem; align-items: flex-start; }
  .jg-row__title { font-size: clamp(1.1rem, 1.9vw, 1.5rem); line-height: 1.2; letter-spacing: -0.022em; }
  .jg-row__excerpt { font-size: var(--fs-sub); color: var(--text-soft); max-width: 62ch; }
  .jg-row__meta { display: flex; gap: 0.5rem; font-size: 0.75rem; color: var(--text-mute); }

  .jg-row__arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    flex: none;
    transition: transform var(--dur-slow) var(--ease-expo), background var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }

  .jg-row a:hover .jg-row__arrow { transform: rotate(45deg); background: var(--c-jet); color: var(--c-beige); border-color: var(--c-jet); }

  /* ── Responsive ──────────────────────────────────────────────────── */
  @media (max-width: 1000px) {
    .jg-feature { grid-template-columns: minmax(0, 1fr); }
    .jg-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .jg-row a { grid-template-columns: 3.5rem 8rem minmax(0, 1fr); }
    .jg-row__arrow { display: none; }
  }

  @media (max-width: 660px) {
    .jg-grid { grid-template-columns: minmax(0, 1fr); }
    .jg-row a { grid-template-columns: 3rem minmax(0, 1fr); gap: 1rem; }
    .jg-row__media { display: none; }
    .jg-mini a { grid-template-columns: 5rem minmax(0, 1fr); gap: 0.9rem; }
  }
</style>
