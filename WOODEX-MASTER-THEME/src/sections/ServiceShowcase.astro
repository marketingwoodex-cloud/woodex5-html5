---
/**
 * SECTION · Service Showcase                  [ service-showcase ]
 * ---------------------------------------------------------------------------
 * Split layout: a large sticky image on one side, an interactive accordion of
 * services on the other. Hovering or clicking a service swaps the image with a
 * cross-fade.
 *
 * MOTION: accordion expand/collapse · image cross-fade · sticky media
 * USED ON: /home-one, /service
 */
import Icon from '../components/ui/Icon.astro';
import { services } from '../data/services.js';
import Img from '../components/ui/Img.astro';


interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  slugs?: string[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'Designed for lasting impact',
  title = 'Comprehensive design and delivery',
  lede = 'Interiors focused on simplicity, balance and lasting impressions.',
  slugs = ['turnkey-interiors', 'office-corporate', 'restaurant-interior', 'custom-furniture-joinery'],
  ctaLabel = 'Discover our work',
  ctaHref = '/portfolio-one',
} = Astro.props;

const items = slugs.map((s) => services.find((x) => x.slug === s)).filter(Boolean);
---

<section class="section service-showcase">
  <div class="container">
    <div class="ss__grid">
      <!-- ── Media ─────────────────────────────────────────────────────── -->
      <div class="ss__media" data-pin>
        <div class="ss__media-inner" data-pin-sticky>
          <div class="media ratio-4-5 ss__stack" data-reveal="clip">
            {items.map((s, i) => (
              <Img
                src={s.image}
                alt={s.title}
                loading={i === 0 ? 'eager' : 'lazy'}
                width="900"
                height="1125"
                class:list={['ss__img', i === 0 && 'is-active']}
                data-ss-img={i}
              />
            ))}

            <span class="ss__badge">
              <Icon name="layers" size={14} stroke={1.8} />
              {items.length} core services
            </span>
          </div>
        </div>
      </div>

      <!-- ── Accordion ─────────────────────────────────────────────────── -->
      <div class="ss__panel">
        <span class="eyebrow" data-reveal="fade">{eyebrow}</span>
        <h2
          class="ss__title"
          data-heading-reveal="words"
          data-heading-stagger="50"
        >
          {title}
        </h2>
        <p class="ss__lede" data-reveal="fade-up" style="--reveal-delay:200ms">{lede}</p>

        <div class="ss__list" data-accordion id="ss-accordion" data-stagger="80">
          {items.map((s, i) => (
            <div
              class:list={['acc-item', i === 0 && 'is-open']}
              data-accordion-item
              data-ss-index={i}
            >
              <h3 style="margin:0">
                <button
                  type="button"
                  class="acc-head"
                  data-accordion-head
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`ss-body-${i}`}
                >
                  <span class="ss__head-inner">
                    <span class="ss__head-no">{String(i + 1).padStart(2, '0')}</span>
                    {s.title}
                  </span>
                  <span class="acc-icon" aria-hidden="true"></span>
                </button>
              </h3>

              <div
                class="acc-body"
                id={`ss-body-${i}`}
                data-accordion-body
                role="region"
              >
                <div class="acc-body__inner">
                  <p>{s.lede}</p>

                  <ul class="ss__deliverables">
                    {s.deliverables.slice(0, 4).map((d) => (
                      <li>
                        <Icon name="check" size={13} stroke={2.2} />
                        {d}
                      </li>
                    ))}
                  </ul>

                  <div class="ss__meta">
                    <span><Icon name="clock" size={13} /> {s.duration}</span>
                    <span><Icon name="calculator" size={13} /> {s.startingAt}</span>
                  </div>

                  <a href={`/services/${s.slug}`} class="text-link">
                    {s.shortTitle} in detail <Icon name="arrow-right" size={14} class="arrow" />
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <a href={ctaHref} class="btn btn--primary btn--lg mt-12" data-reveal="fade-up">
          <span class="btn__label"><span>{ctaLabel}</span></span>
          <span class="btn__chip" aria-hidden="true"><Icon name="arrow-right" size={12} stroke={2.4} /></span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  /* Swap the sticky image whenever a different accordion row is opened/hovered. */
  const root = document.getElementById('ss-accordion');
  const imgs = [...document.querySelectorAll('[data-ss-img]')];

  const setActive = (index) => {
    imgs.forEach((img) => img.classList.toggle('is-active', Number(img.dataset.ssImg) === index));
  };

  root?.querySelectorAll('[data-ss-index]').forEach((item) => {
    const index = Number(item.dataset.ssIndex);
    item.querySelector('[data-accordion-head]')?.addEventListener('click', () => setActive(index));
    item.addEventListener('mouseenter', () => setActive(index));
  });
</script>

<style>
  .ss__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  /* ── Media stack ───────────────────────────────────────────────────── */
  .ss__stack { position: relative; }

  .ss__stack :global(img.ss__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.05);
    transition: opacity 700ms var(--ease-soft), transform 1200ms var(--ease-expo);
  }

  .ss__stack :global(img.ss__img.is-active) {
    opacity: 1;
    transform: scale(1);
  }

  .ss__badge {
    position: absolute;
    inset-block-end: 1rem;
    inset-inline-start: 1rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.95rem;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--c-beige) 92%, transparent);
    color: var(--c-jet);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  /* ── Panel ─────────────────────────────────────────────────────────── */
  .ss__title {
    margin-top: 1.25rem;
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    line-height: 1.14;
    letter-spacing: -0.028em;
    max-width: 20ch;
  }

  .ss__lede {
    margin-top: 1.25rem;
    max-width: 50ch;
    color: var(--text-soft);
  }

  .ss__list { margin-top: 2.5rem; border-top: 1px solid var(--line); }

  .ss__head-inner {
    display: inline-flex;
    align-items: baseline;
    gap: 1rem;
  }

  .ss__head-no {
    font-family: var(--ff-body);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: var(--text-mute);
    flex: none;
  }

  .ss__deliverables {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem 1.5rem;
    margin-top: 1.25rem;
  }

  .ss__deliverables li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: var(--fs-sub);
    color: var(--text-soft);
  }

  .ss__deliverables li :global(svg) { margin-top: 0.28rem; flex: none; }

  .ss__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-sub);
    color: var(--text-soft);
  }

  .ss__meta span { display: inline-flex; align-items: center; gap: 0.5rem; }

  .ss__deliverables + :global(.text-link) { margin-top: 1.5rem; }
  .ss__panel .text-link { margin-top: 1.5rem; }

  /* ── Responsive ────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .ss__grid { grid-template-columns: minmax(0, 1fr); }
    .ss__media-inner { position: static !important; }
    .ss__deliverables { grid-template-columns: minmax(0, 1fr); }
  }
</style>
