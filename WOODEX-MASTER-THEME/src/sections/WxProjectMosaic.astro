---
/**
 * WX PROJECT MOSAIC — "Studies — rooms drawn so they can be built".
 * ---------------------------------------------------------------------------
 * A four-tile asymmetric grid: two standard tiles, one tall tile with an
 * overlay caption, and one wide tile. The asymmetry is the point — it breaks
 * the card-grid monotony that made earlier layouts read as a template.
 */
import { mosaic } from '../data/home.js';

const { title, href, items } = mosaic;
---

<section class="mo">
  <div class="container">
    <div class="mo__head" data-reveal="fade-up">
      <h2 data-heading-reveal="words" data-heading-stagger="46">{title}</h2>
      <a class="mo__all" href={href}>
        All studies
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </a>
    </div>

    <div class="mo__grid">
      {items.map((p, i) => (
        <a
          class:list={['mo__tile', p.size === 'tall' && 'mo__tile--tall', p.size === 'wide' && 'mo__tile--wide']}
          href={href}
          data-reveal="fade-up"
          style={`--reveal-delay:${i * 80}ms`}
        >
          <img src={p.image} alt={p.alt} width="1408" height="768" loading="lazy" data-tone="none" />
          <span class="mo__shade" aria-hidden="true"></span>

          {p.size === 'tall' && p.copy ? (
            <span class="mo__overlay">
              <strong>{p.title}</strong>
              <em>{p.copy}</em>
              <span class="mo__go" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </span>
            </span>
          ) : (
            <span class="mo__cap">{p.title}</span>
          )}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .mo {
    padding-block: clamp(4rem, 8vw, 7.5rem);
    background: var(--c-white);
    color: var(--c-ink);
  }
  .mo__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
    flex-wrap: wrap;
  }
  .mo h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.3vw, 2.9rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.036em;
    max-width: 26ch;
  }
  .mo__all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--c-ink);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--line-strong);
    transition: color 0.4s var(--ease-out), border-color 0.4s var(--ease-out);
  }
  .mo__all svg { width: 15px; height: 15px; transition: transform 0.4s var(--ease-out); }
  .mo__all:hover { color: var(--c-wood, #b8956a); border-color: var(--c-wood, #b8956a); }
  .mo__all:hover svg { transform: translateX(4px); }

  .mo__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /* Explicit row height: with a spanning tile in the grid, `1fr` rows are
       circular and resolve against content, which makes the whole mosaic
       stretch. A fixed row height keeps every tile exactly where it belongs. */
    grid-auto-rows: clamp(13rem, 21vw, 20rem);
    gap: clamp(0.75rem, 1.4vw, 1.15rem);
  }
  .mo__tile {
    position: relative;
    display: block;
    border-radius: var(--r-md, 16px);
    overflow: hidden;
    background: var(--c-navy);
    text-decoration: none;
  }
  .mo__tile--tall { grid-row: span 2; }
  .mo__tile--wide { grid-column: span 2; }
  .mo__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }
  .mo__tile:hover img,
  .mo__tile:focus-visible img { transform: scale(1.05); }

  .mo__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(12, 22, 40, 0.74) 0%, rgba(12, 22, 40, 0) 48%);
    opacity: 0.9;
    transition: opacity 0.5s var(--ease-out);
  }
  .mo__tile:hover .mo__shade { opacity: 1; }

  .mo__cap {
    position: absolute;
    left: clamp(0.9rem, 2vw, 1.35rem);
    bottom: clamp(0.9rem, 2vw, 1.35rem);
    z-index: 2;
    color: var(--c-white);
    font-size: clamp(0.95rem, 1.4vw, 1.12rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .mo__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    align-content: end;
    gap: 8px;
    padding: clamp(1.1rem, 2.2vw, 1.75rem);
    color: var(--c-white);
    background: linear-gradient(0deg, rgba(12, 22, 40, 0.86) 0%, rgba(12, 22, 40, 0.12) 62%);
  }
  .mo__overlay strong {
    font-size: clamp(1.15rem, 1.9vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.028em;
  }
  .mo__overlay em {
    font-style: normal;
    font-size: 0.92rem;
    line-height: 1.58;
    color: rgba(255, 255, 255, 0.72);
    max-width: 34ch;
  }
  .mo__go {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-top: 8px;
    border-radius: 50%;
    background: var(--c-cream);
    color: var(--c-navy);
    transition: transform 0.45s var(--ease-out), background 0.45s var(--ease-out);
  }
  .mo__go svg { width: 15px; height: 15px; }
  .mo__tile:hover .mo__go { transform: translateX(5px) rotate(-45deg); background: var(--c-wood, #b8956a); }

  @media (max-width: 1024px) {
    .mo__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mo__tile--wide { grid-column: span 2; }
    .mo__tile--tall { grid-row: span 2; }
  }
  @media (max-width: 640px) {
    .mo__grid { grid-template-columns: 1fr; }
    .mo__grid { grid-auto-rows: 14.5rem; }
    .mo__tile,
    .mo__tile--wide { grid-column: auto; }
    .mo__tile--tall { grid-row: span 1; }
  }
</style>
