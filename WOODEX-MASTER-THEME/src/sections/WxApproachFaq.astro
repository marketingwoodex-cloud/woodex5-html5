---
/**
 * WX APPROACH / FAQ — "First we understand the space. Then we design it."
 * ---------------------------------------------------------------------------
 * One full-bleed image carrying the position statement, with the five real
 * client questions answered beside it. The accordion is a native <details>
 * element: it opens without JavaScript, is announced correctly, and keeps the
 * whole answer in the DOM for search engines.
 */
import Btn from '../components/ui/Btn.astro';
import { approach } from '../data/home.js';

const { image, alt, title, lede, cta, faqs } = approach;
---

<section class="af">
  <div class="container af__grid">
    <div class="af__visual" data-reveal="fade-up">
      <img src={image} alt={alt} width="1408" height="768" loading="lazy" data-tone="none" />
      <div class="af__overlay">
        <h2 data-heading-reveal="words" data-heading-stagger="52">{title}</h2>
        <p>{lede}</p>
        <Btn href={cta.href} label={cta.label} variant="light" />
      </div>
    </div>

    <div class="af__faq">
      {faqs.map((f, i) => (
        <details class="af__item" open={i === 0} data-reveal="fade-up" style={`--reveal-delay:${i * 70}ms`}>
          <summary>
            <span class="af__q">{f.q}</span>
            <span class="af__plus" aria-hidden="true"></span>
          </summary>
          <div class="af__a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .af {
    padding-block: clamp(4.5rem, 9vw, 8.5rem);
    background: var(--c-cream);
    color: var(--c-ink);
  }
  .af__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 4.5vw, 4rem);
    align-items: stretch;
  }

  /* ── Statement plate ──────────────────────────────────────────────────── */
  .af__visual {
    position: relative;
    border-radius: var(--r-lg, 24px);
    overflow: hidden;
    min-height: 30rem;
    display: grid;
    align-content: end;
    background: var(--c-navy);
  }
  .af__visual > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .af__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Two stops so the copy is legible even over a bright, busy photograph. */
    background:
      linear-gradient(0deg, rgba(12, 22, 40, 0.94) 0%, rgba(12, 22, 40, 0.72) 42%, rgba(12, 22, 40, 0.3) 100%),
      linear-gradient(90deg, rgba(12, 22, 40, 0.5) 0%, rgba(12, 22, 40, 0) 62%);
  }
  .af__overlay {
    position: relative;
    z-index: 2;
    padding: clamp(1.5rem, 3vw, 2.75rem);
    color: var(--c-white);
  }
  .af__overlay h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.7rem, 3.1vw, 2.7rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.038em;
    max-width: 18ch;
  }
  .af__overlay p {
    margin: 0 0 1.6rem;
    max-width: 44ch;
    font-size: 0.98rem;
    line-height: 1.68;
    color: rgba(255, 255, 255, 0.76);
  }

  /* ── Accordion ────────────────────────────────────────────────────────── */
  .af__faq {
    display: grid;
    align-content: start;
    border-top: 1px solid var(--line);
  }
  .af__item { border-bottom: 1px solid var(--line); }
  .af__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.2rem 0;
    cursor: pointer;
    list-style: none;
    font-size: clamp(0.98rem, 1.4vw, 1.1rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    transition: color 0.4s var(--ease-out);
  }
  .af__item summary::-webkit-details-marker { display: none; }
  .af__item summary:hover { color: var(--c-navy); }
  .af__item[open] summary { color: var(--c-navy); }
  .af__plus {
    position: relative;
    width: 16px;
    height: 16px;
    flex: none;
  }
  .af__plus::before,
  .af__plus::after {
    content: '';
    position: absolute;
    background: currentColor;
    transition: transform 0.4s var(--ease-out), opacity 0.4s var(--ease-out);
  }
  .af__plus::before { top: 50%; left: 0; width: 100%; height: 1.5px; transform: translateY(-50%); }
  .af__plus::after { left: 50%; top: 0; height: 100%; width: 1.5px; transform: translateX(-50%); }
  .af__item[open] .af__plus::after { transform: translateX(-50%) scaleY(0); opacity: 0; }
  .af__a { padding: 0 2.5rem 1.4rem 0; }
  .af__a p {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.7;
    color: var(--c-muted);
  }

  @media (max-width: 940px) {
    .af__grid { grid-template-columns: 1fr; }
    .af__visual { min-height: 24rem; }
  }
</style>
