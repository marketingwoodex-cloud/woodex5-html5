---
/**
 * SECTION · Stats Strip                       [ stats-strip ]
 * ---------------------------------------------------------------------------
 * Two jobs in one component, chosen by `variant`:
 *   variant="numbers"   → large animated counters over a rule grid
 *   variant="promises"  → the four guarantees, each with an icon
 *   variant="mixed"     → counters on top, promises beneath
 */
import Icon from '../components/ui/Icon.astro';
import { site } from '../data/site.js';
import { guarantees } from '../data/content.js';
import Img from '../components/ui/Img.astro';


interface Props {
  variant?: 'numbers' | 'promises' | 'mixed';
  eyebrow?: string;
  title?: string;
  theme?: 'dark' | 'beige' | 'gray';
  image?: string;
}

const {
  variant = 'numbers',
  eyebrow = 'By the numbers',
  title = 'Organizational capability building',
  theme = 'dark',
  image = '',
} = Astro.props;
---

<section class:list={['stats-strip', 'section']} data-theme={theme}>
  {image && (
    <div class="stats-strip__bg" aria-hidden="true">
      <Img src={image} alt="" loading="lazy" width="1920" height="900" />
      <span></span>
    </div>
  )}

  <div class="container">
    {(variant === 'promises' || variant === 'mixed') && (
      <div class="sec-head">
        <div class="sec-head__text">
          <span class="eyebrow" data-reveal="fade">{eyebrow}</span>
          <h2 data-heading-reveal="words" data-heading-stagger="48">{title}</h2>
        </div>
      </div>
    )}

    {variant === 'numbers' && (
      <div class="st__head">
        <span class="eyebrow" data-reveal="fade">{eyebrow}</span>
      </div>
    )}

    <!-- ══ Counters ════════════════════════════════════════════════════ -->
    {(variant === 'numbers' || variant === 'mixed') && (
      <div class="st__numbers" data-stagger="120">
        {site.stats.map((s) => (
          <div class="st__num" data-reveal="fade-up">
            <strong
              data-counter={s.value}
              data-counter-suffix={s.suffix ?? ''}
              data-counter-decimals={s.decimals ?? 0}
              data-counter-duration="2000"
            >0</strong>
            <span>{s.label}</span>
            <i aria-hidden="true"></i>
          </div>
        ))}
      </div>
    )}

    <!-- ══ Promises ════════════════════════════════════════════════════ -->
    {(variant === 'promises' || variant === 'mixed') && (
      <div class:list={['st__promises', variant === 'mixed' && 'has-rule']} data-stagger="100">
        {guarantees.map((g) => (
          <article class="st__promise" data-reveal="fade-up">
            <span class="st__icon" aria-hidden="true">
              <Icon name={g.icon} size={18} stroke={1.7} />
            </span>
            <h3 class="st__promise-title">{g.title}</h3>
            <p class="st__promise-text">{g.text}</p>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .stats-strip { position: relative; overflow: hidden; isolation: isolate; }

  .stats-strip__bg { position: absolute; inset: 0; z-index: -2; }
  .stats-strip__bg img { width: 100%; height: 100%; object-fit: cover; }
  .stats-strip__bg span {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.86), rgba(0, 0, 0, 0.94));
  }

  .st__head { margin-bottom: clamp(2rem, 4vw, 3.5rem); }

  /* ══ Counters ══════════════════════════════════════════════════════ */
  .st__numbers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border-block: 1px solid var(--line);
  }

  .stats-strip[data-theme='dark'] .st__numbers { background: var(--line-invert); border-color: var(--line-invert); }

  .st__num {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.75rem, 3.5vw, 3rem) clamp(1.25rem, 2.5vw, 2rem);
    background: var(--bg);
    overflow: hidden;
  }

  .st__num strong {
    font-family: var(--ff-display);
    font-size: clamp(2.4rem, 5.5vw, 4.25rem);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .st__num span {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Animated rule that grows on reveal */
  .st__num i {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1.4s var(--ease-expo) 0.2s;
  }

  .st__num.is-in i { transform: scaleX(1); }

  /* ══ Promises ══════════════════════════════════════════════════════ */
  .st__promises {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .st__promises.has-rule {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .stats-strip[data-theme='dark'] .st__promises.has-rule { border-color: var(--line-invert); }

  .st__promise { display: flex; flex-direction: column; gap: 0.85rem; }

  .st__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out), transform var(--dur-slow) var(--ease-expo);
  }

  .st__promise:hover .st__icon {
    background: currentColor;
    transform: translateY(-0.25rem);
  }

  .st__promise:hover .st__icon :global(svg) { color: var(--bg); }

  .st__promise-title { font-size: 1.0625rem; letter-spacing: -0.012em; }

  .st__promise-text {
    font-size: var(--fs-sub);
    color: var(--text-soft);
    max-width: 30ch;
  }

  /* ── Responsive ──────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .st__numbers { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .st__promises { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .st__numbers { grid-template-columns: minmax(0, 1fr); }
    .st__promises { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  }
</style>
