---
/**
 * WX STORY GATES — "Drawn. Then built."
 * ---------------------------------------------------------------------------
 * The practice's core positioning, plus the three gates a visitor self-selects
 * into: empty space, existing drawings, or 3D only. The gates are the whole
 * point of the section, so they are full-row links with a hairline, a rolling
 * arrow and a real hover affordance — not a row of icon cards.
 */
import { story } from '../data/home.js';

const { eyebrow, title, lede, gates, image, alt, chipTitle, chipText } = story;
---

<section class="st">
  <div class="container st__grid">
    <div class="st__copy">
      <p class="st__eyebrow" data-reveal="fade-up"><i aria-hidden="true"></i>{eyebrow}</p>
      <h2 data-heading-reveal="words" data-heading-stagger="50">{title}</h2>
      <p class="st__lede" data-reveal="fade-up" style="--reveal-delay:120ms">{lede}</p>

      <div class="st__gates">
        {gates.map((g, i) => (
          <a class="st__gate" href={g.href} data-reveal="fade-up" style={`--reveal-delay:${180 + i * 80}ms`}>
            <span class="st__gate-body">
              <h3>{g.title}</h3>
              <p>{g.copy}</p>
            </span>
            <span class="st__go" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="st__visual" data-reveal="fade-up" style="--reveal-delay:80ms">
      <img src={image} alt={alt} width="1408" height="768" loading="lazy" data-tone="none" />
      <div class="st__chip">
        <strong>{chipTitle}</strong>
        <span>{chipText}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .st {
    padding-block: clamp(4.5rem, 9vw, 8.5rem);
    background: var(--c-white);
    color: var(--c-ink);
  }
  .st__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .st__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .st__eyebrow i { width: 22px; height: 1px; background: var(--c-wood, #b8956a); flex: none; }
  .st h2 {
    margin: 0 0 1.1rem;
    font-size: clamp(2.1rem, 4.4vw, 3.8rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.042em;
  }
  .st__lede {
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    max-width: 52ch;
    font-size: 1.04rem;
    line-height: 1.72;
    color: var(--c-muted);
  }

  /* ── Gates ────────────────────────────────────────────────────────────── */
  .st__gates { display: grid; }
  .st__gate {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(1.3rem, 2.4vw, 1.8rem) 0;
    border-top: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: padding-left 0.5s var(--ease-out), background 0.5s var(--ease-out);
  }
  .st__gate:last-child { border-bottom: 1px solid var(--line); }
  .st__gate::after {
    content: '';
    position: absolute;
    left: -1.5rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--c-wood, #b8956a);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.5s var(--ease-out);
  }
  .st__gate:hover,
  .st__gate:focus-visible { padding-left: 1.25rem; }
  .st__gate:hover::after,
  .st__gate:focus-visible::after { transform: scaleY(1); }
  .st__gate h3 {
    margin: 0 0 6px;
    font-size: clamp(1.12rem, 1.9vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.028em;
  }
  .st__gate p {
    margin: 0;
    max-width: 52ch;
    font-size: 0.94rem;
    line-height: 1.62;
    color: var(--c-muted);
  }
  .st__go {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--c-ink);
    flex: none;
    transition: background 0.4s var(--ease-out), color 0.4s var(--ease-out), border-color 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }
  .st__go svg { width: 16px; height: 16px; }
  .st__gate:hover .st__go,
  .st__gate:focus-visible .st__go {
    background: var(--c-navy);
    border-color: var(--c-navy);
    color: var(--c-cream);
    transform: translateX(4px);
  }

  /* ── Visual ───────────────────────────────────────────────────────────── */
  .st__visual {
    position: relative;
    border-radius: var(--r-lg, 24px);
    overflow: hidden;
    aspect-ratio: 4 / 4.4;
    background: var(--c-cream);
    /* Nudge the tall crop down the grid so the copy column reads first. */
    margin-top: clamp(0rem, 4vw, 3rem);
  }
  .st__visual img { width: 100%; height: 100%; object-fit: cover; }
  .st__chip {
    position: absolute;
    left: clamp(1rem, 2vw, 1.5rem);
    right: clamp(1rem, 2vw, 1.5rem);
    bottom: clamp(1rem, 2vw, 1.5rem);
    display: grid;
    gap: 5px;
    padding: 1.1rem 1.25rem;
    border-radius: var(--r-md, 16px);
    background: rgba(244, 239, 231, 0.94);
    backdrop-filter: blur(10px);
    color: var(--c-ink);
  }
  .st__chip strong { font-size: 1rem; font-weight: 600; letter-spacing: -0.02em; }
  .st__chip span { font-size: 0.86rem; line-height: 1.5; color: var(--c-muted); }

  @media (max-width: 940px) {
    .st__grid { grid-template-columns: 1fr; }
    .st__visual { aspect-ratio: 4 / 3.2; margin-top: 0; }
  }
</style>
