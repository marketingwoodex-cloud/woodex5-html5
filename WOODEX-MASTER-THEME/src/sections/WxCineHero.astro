---
/**
 * WX CINE HERO — the three-slide full-viewport hero.
 * ---------------------------------------------------------------------------
 * The signature section of the Woodex home page. Each slide carries its own
 * headline, copy and CTA over a full-bleed image with a Ken Burns drift; the
 * crossfade is a soft clip reveal rather than a hard cut.
 *
 * Furniture around the slides, all decorative:
 *   • side words      — Layout / Design / Create, the active one lit
 *   • vertical rules  — four hairlines, a quiet architectural cue
 *   • ghost index     — the active word set large behind the copy
 *   • nav             — 01/02/03 pips with a progress track, plus arrows
 *
 * Behaviour lives in src/scripts/woodex-home.js. With JS off, slide one shows
 * and the pips are inert — the page is still complete.
 */
import Btn from '../components/ui/Btn.astro';
import { hero } from '../data/home.js';

const { slides } = hero;
const sideWords = slides.map((s) => s.side);
---

<section class="cine" data-cine aria-roledescription="carousel" aria-label="Featured stories">
  <div class="cine__slides">
    {
      slides.map((s, i) => (
        <article class:list={['cine__slide', i === 0 && 'is-active']} data-cine-slide aria-hidden={i !== 0}>
          <div class="cine__media">
            <img
              src={s.image}
              alt={s.alt}
              width="1408"
              height="768"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              data-tone="none"
            />
          </div>
          <div class="cine__shade" aria-hidden="true"></div>

          <div class="cine__content">
            <div class="container">
              <p class="cine__label">
                <i aria-hidden="true"></i>
                {s.label}
              </p>
              <h1>
                {s.lines.map((line) => (
                  <span class="line">
                    <span>{line}</span>
                  </span>
                ))}
              </h1>
              <div class="cine__cta">
                <Btn href={s.cta.href} label={s.cta.label} variant="light" size="lg" />
                <p class="cine__copy">{s.copy}</p>
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="cine__side" aria-hidden="true">
    {sideWords.map((w, i) => <span class:list={[i === 0 && 'is-on']}>{w}</span>)}
  </div>

  <div class="cine__rules" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="cine__ghost" aria-hidden="true">{sideWords[0]}</div>

  <div class="cine__nav">
    <div class="container cine__nav-inner">
      <div class="cine__pips" role="tablist" aria-label="Slides">
        {
          slides.map((s, i) => (
            <button
              class:list={['cine__pip', i === 0 && 'is-active']}
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`Slide ${i + 1}: ${s.lines.join(' ')}`}
              data-cine-pip={i}
            >
              <span>{String(i + 1).padStart(2, '0')}</span>
              <span class="track"><i></i></span>
            </button>
          ))
        }
      </div>

      <div class="cine__arrows">
        <button class="cine__arrow" type="button" aria-label="Previous slide" data-cine-prev>
          <svg viewBox="0 0 16 16" fill="none">
            <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
        <button class="cine__arrow" type="button" aria-label="Next slide" data-cine-next>
          <svg viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .cine {
    position: relative;
    height: 100svh;
    min-height: 720px;
    overflow: hidden;
    background: var(--c-navy);
    color: var(--c-white);
  }

  /* ── Slides ───────────────────────────────────────────────────────────── */
  .cine__slides,
  .cine__slide {
    position: absolute;
    inset: 0;
  }
  .cine__slide {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.1s var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      visibility 0s linear 1.1s;
  }
  .cine__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 1.1s var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      visibility 0s;
  }
  .cine__media { position: absolute; inset: 0; overflow: hidden; }
  .cine__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Ken Burns: slow drift, only on the active slide. */
    transform: scale(1.06);
    transition: transform 9s linear;
  }
  .cine__slide.is-active .cine__media img { transform: scale(1.14); }

  .cine__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(12, 22, 40, 0.88) 0%, rgba(12, 22, 40, 0.55) 46%, rgba(12, 22, 40, 0.22) 100%),
      linear-gradient(0deg, rgba(12, 22, 40, 0.86) 0%, rgba(12, 22, 40, 0) 46%);
  }

  /* ── Copy ─────────────────────────────────────────────────────────────── */
  .cine__content {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    align-items: center;
    padding-bottom: 108px;
  }
  .cine__label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-wood, #b8956a);
  }
  .cine__label i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }

  .cine h1 {
    margin: 0;
    max-width: 15ch;
    font-size: clamp(2.9rem, 6.4vw, 5.6rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.042em;
    color: var(--c-white);
  }
  .cine h1 .line { display: block; overflow: hidden; }
  .cine h1 .line > span {
    display: block;
    transform: translateY(118%);
    transition: transform 1.05s var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }
  .cine__slide.is-active h1 .line > span { transform: translateY(0); }
  .cine__slide.is-active h1 .line:nth-child(2) > span { transition-delay: 0.1s; }

  .cine__cta {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.9s var(--ease-out) 0.42s, transform 0.9s var(--ease-out) 0.42s;
  }
  .cine__slide.is-active .cine__cta { opacity: 1; transform: none; }
  .cine__copy {
    margin: 0;
    max-width: 34ch;
    font-size: 0.98rem;
    line-height: 1.62;
    color: rgba(255, 255, 255, 0.74);
  }

  /* ── Furniture ────────────────────────────────────────────────────────── */
  .cine__side {
    position: absolute;
    right: clamp(1.25rem, 3.2vw, 3rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: grid;
    gap: 0.7rem;
    justify-items: end;
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
  }
  .cine__side span { transition: color 0.6s var(--ease-out); }
  .cine__side span.is-on { color: var(--c-cream); }

  .cine__rules {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-inline: clamp(1.25rem, 6vw, 8rem);
  }
  .cine__rules i { border-left: 1px solid rgba(255, 255, 255, 0.08); }
  .cine__rules i:last-child { border-right: 1px solid rgba(255, 255, 255, 0.08); }

  .cine__ghost {
    position: absolute;
    right: -0.04em;
    bottom: 0.16em;
    z-index: 2;
    font-size: clamp(5rem, 17vw, 15rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.8;
    color: rgba(255, 255, 255, 0.05);
    pointer-events: none;
    user-select: none;
  }

  /* ── Nav ──────────────────────────────────────────────────────────────── */
  .cine__nav {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 4;
    padding-block: clamp(1rem, 2vw, 1.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(6px);
  }
  .cine__nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .cine__pips { display: flex; gap: clamp(1rem, 3vw, 2.25rem); }
  .cine__pip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 0;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    transition: color 0.4s var(--ease-out);
  }
  .cine__pip.is-active { color: var(--c-cream); }
  .cine__pip .track {
    display: block;
    width: clamp(38px, 7vw, 84px);
    height: 2px;
    background: rgba(255, 255, 255, 0.18);
    overflow: hidden;
  }
  .cine__pip .track i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--c-wood, #b8956a);
    transform: scaleX(0);
    transform-origin: left;
  }
  .cine__pip.is-active .track i { animation: cine-pip-fill 7.2s linear forwards; }
  .cine[data-paused='true'] .cine__pip.is-active .track i { animation-play-state: paused; }
  @keyframes cine-pip-fill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .cine__arrows { display: flex; gap: 10px; }
  .cine__arrow {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.24);
    color: var(--c-cream);
    transition: background 0.4s var(--ease-out), color 0.4s var(--ease-out), border-color 0.4s var(--ease-out);
  }
  .cine__arrow svg { width: 16px; height: 16px; }
  .cine__arrow:hover {
    background: var(--c-cream);
    color: var(--c-navy);
    border-color: var(--c-cream);
  }

  /* ── Responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 1100px) {
    .cine__side { display: none; }
    .cine__ghost { font-size: 22vw; opacity: 0.7; }
  }
  @media (max-width: 820px) {
    .cine { min-height: 640px; }
    .cine__content { padding-bottom: 132px; align-items: flex-end; }
    .cine h1 { font-size: clamp(2.4rem, 9vw, 3.4rem); }
    .cine__cta { gap: 1.25rem; margin-top: 1.75rem; }
    .cine__copy { font-size: 0.92rem; }
    .cine__pip .track { width: 34px; }
    .cine__arrow { width: 42px; height: 42px; }
    .cine__rules { display: none; }
  }
  @media (max-width: 560px) {
    .cine__ghost { display: none; }
    .cine__pip span:first-child { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cine__media img,
    .cine h1 .line > span,
    .cine__cta,
    .cine__slide {
      transition: none !important;
    }
    .cine h1 .line > span { transform: none; }
    .cine__cta { opacity: 1; transform: none; }
    .cine__pip.is-active .track i { animation: none; transform: scaleX(1); }
  }
</style>
