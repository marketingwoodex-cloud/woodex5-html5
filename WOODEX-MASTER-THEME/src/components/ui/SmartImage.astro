---
/**
 * SMART IMAGE — the theme's single image entry point.
 * ---------------------------------------------------------------------------
 * Why this exists:
 *   1. Prevents EVER shipping a broken <img>. If the file is missing from
 *      /public at build time, we render a designed SVG placeholder in the
 *      brand palette instead — so the site always looks intentional.
 *   2. Applies consistent lazy-loading, decoding hints, aspect ratio and
 *      object-position defaults across every section.
 *   3. Lets you swap imagery by editing one manifest (images.js), not markup.
 *
 * Usage:
 *   <SmartImage src="/images/services/kitchen-interior.jpg" alt="Kitchen" ratio="4/3" />
 *
 * Swapping real photography in later:
 *   Drop your file at the same path in /public/images/… — it just works.
 *   Or change the path in src/data/images.js and every usage updates.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  src: string;
  alt?: string;
  /** CSS aspect-ratio, e.g. "4/3". Omit to let the image size itself. */
  ratio?: string;
  /** Responsive width / height attributes to reserve layout space. */
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  /** object-position, e.g. "center 30%" */
  position?: string;
  sizes?: string;
  /** Placeholder label shown inside the fallback SVG. */
  label?: string;
  /** Overlay caption rendered on the fallback only — never on real photos. */
  decorative?: boolean;
}

const {
  src,
  alt = '',
  ratio,
  width = 1600,
  height = 1200,
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className = '',
  position = 'center',
  sizes,
  label,
  decorative = false,
} = Astro.props;

/* ── Build-time existence check ─────────────────────────────────────────
   `src` is a public path like /images/hero/hero-one-main.jpg           */
const publicPath = path.join(process.cwd(), 'public', src.replace(/^\//, ''));
const exists = fs.existsSync(publicPath);

const [rw, rh] = ratio
  ? ratio.split('/').map((n) => Number(n.trim()))
  : [width, height];

const placeholderLabel =
  label ?? path.basename(src, path.extname(src)).replace(/[-_]/g, ' ');
---

{
  exists ? (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      sizes={sizes}
      class={className}
      style={ratio ? `aspect-ratio:${rw}/${rh};object-fit:cover;object-position:${position}` : `object-position:${position}`}
    />
  ) : (
    /* ── Designed fallback: never a broken image icon ──────────────────── */
    <svg
      viewBox="0 0 100 75"
      preserveAspectRatio="xMidYMid slice"
      class:list={['smart-ph', className]}
      role={alt ? 'img' : 'presentation'}
      aria-label={alt || undefined}
      style={ratio ? `aspect-ratio:${rw}/${rh}` : undefined}
    >
      <defs>
        <linearGradient id="sg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#fcf2e8" />
          <stop offset="55%" stop-color="#e3e1e1" />
          <stop offset="100%" stop-color="#d9d9d9" />
        </linearGradient>
        <pattern id="sp" width="10" height="10" patternUnits="userSpaceOnUse">
          <path d="M0 10L10 0" stroke="#00000010" stroke-width=".4" />
        </pattern>
      </defs>

      <rect width="100" height="75" fill="url(#sg)" />
      <rect width="100" height="75" fill="url(#sp)" />

      {/* Stylised interior abstraction: arch + horizon + light shaft */}
      <path d="M18 60V34a14 14 0 0 1 28 0v26Z" fill="#ffffff" opacity=".5" />
      <path d="M52 60V42a9 9 0 0 1 18 0v18Z" fill="#ffffff" opacity=".34" />
      <path d="M0 60h100v1.2H0z" fill="#00000018" />
      <path d="M78 0 100 0 62 75 40 75Z" fill="#ffffff" opacity=".26" />

      {!decorative && (
        <text
          x="50"
          y="70"
          text-anchor="middle"
          font-family="system-ui, sans-serif"
          font-size="3.1"
          letter-spacing=".5"
          fill="#525252"
          opacity=".72"
          style="text-transform:uppercase"
        >
          {placeholderLabel.slice(0, 34)}
        </text>
      )}
    </svg>
  )
}

<style>
  .smart-ph { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
