---
/**
 * HOME — the Woodex home page.
 * ---------------------------------------------------------------------------
 * A redesign of the practice's existing home page, rebuilt on the master theme
 * so it shares the token system, motion engine, data layer and deployment path
 * with the other 40+ templates.
 *
 * Section order follows the original site, because the order is the argument:
 *   1  Cine hero           three slides — the three ways in
 *   2  Service switcher    six services you can actually buy
 *   3  Studio pin          stills → walkthrough → BOQ, pinned on scroll
 *   4  Story gates         "Drawn. Then built." + the three gates
 *   5  Doc grid            how a room is documented
 *   6  Stat cards          the proof numbers
 *   7  Practice            one team, one process, one result
 *   8  Project mosaic      studies, four asymmetric tiles
 *   9  Marquee             discipline band
 *   10 Approach / FAQ      the brief is the contract
 *   11 Featured            from approved still to BOQ and site
 *   12 CTA                 tell us about your space
 *
 * All copy lives in src/data/home.js.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WxCineHero from '../sections/WxCineHero.astro';
import WxServiceSwitcher from '../sections/WxServiceSwitcher.astro';
import WxStudioPin from '../sections/WxStudioPin.astro';
import WxStoryGates from '../sections/WxStoryGates.astro';
import WxDocGrid from '../sections/WxDocGrid.astro';
import WxStatCards from '../sections/WxStatCards.astro';
import WxPractice from '../sections/WxPractice.astro';
import WxProjectMosaic from '../sections/WxProjectMosaic.astro';
import WxApproachFaq from '../sections/WxApproachFaq.astro';
import WxFeatured from '../sections/WxFeatured.astro';
import MarqueeText from '../sections/MarqueeText.astro';
import CtaBand from '../sections/CtaBand.astro';
import { marqueeWords, cta } from '../data/home.js';
import { site } from '../data/site.js';
---

<BaseLayout
  title={`${site.name} — Interiors drawn, then built`}
  description="Woodex Interior: design, in-house 3D visualisation, budget and BOQ, joinery and execution. 500+ projects, ISO 9001, studios in Lahore, Karachi and Islamabad."
  image="/images/woodex/hero-1.jpg"
  footer="woodex"
  whatsapp
  script="woodex-home"
  bodyClass="wx-home"
>
  <WxCineHero />
  <WxServiceSwitcher />
  <WxStudioPin />
  <WxStoryGates />
  <WxDocGrid />
  <WxStatCards />
  <WxPractice />
  <WxProjectMosaic />
  <MarqueeText items={marqueeWords} size="xl" variant="dark" separator="star" speed="64" />
  <WxApproachFaq />
  <WxFeatured />
  <CtaBand
    variant="banner"
    theme="dark"
    title={cta.title}
    lede={cta.copy}
    image={cta.image}
    primary={{ label: cta.label, href: cta.href }}
    secondary={{ label: 'See our work', href: '/projects' }}
  />
</BaseLayout>

<style is:global>
  /* The Woodex home runs on the navy/cream system, so the image treatment is
     off: every photograph here is already art-directed to the palette. */
  .wx-home { background: var(--c-white); color: var(--c-ink); }
</style>
