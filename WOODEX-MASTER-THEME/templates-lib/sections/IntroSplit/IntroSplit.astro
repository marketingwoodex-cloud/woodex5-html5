---
/**
 * SECTION · Intro Split                       [ intro-split ]
 * ---------------------------------------------------------------------------
 * Eyebrow + statement heading on the left, supporting copy and inline
 * statistics on the right. The workhorse "about the studio" opener.
 *
 * MOTION: masked heading · staggered stats
 * USED ON: /home-one, /about, /service
 */
import Icon from '../components/ui/Icon.astro';
import Img from '../components/ui/Img.astro';


interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  stats?: { value: number; suffix?: string; decimals?: number; label: string }[];
  link?: { label: string; href: string };
  image?: string;
  imageCaption?: string;
  reverse?: boolean;
}

const {
  eyebrow = 'Shaping better spaces',
  title = 'We design innovative spaces that blend creativity, function and sustainability',
  body = 'We design interiors that balance functionality, aesthetics and innovation — creating environments that inspire, endure, and improve the way people live and work. Every decision is drawn, specified and costed before it reaches site.',
  stats = [
    { value: 240, suffix: '+', label: 'Projects delivered' },
    { value: 12, suffix: '', label: 'Years in practice' },
    { value: 98, suffix: '%', label: 'Client retention' },
  ],
  link,
  image,
  imageCaption,
  reverse = false,
} = Astro.props;
---

<section class="section intro-split">
  <div class="container">
    <div class:list={['intro-split__grid', reverse && 'is-reverse']}>
      <!-- ── Text column ───────────────────────────────────────────────── -->
      <div class="intro-split__text">
        <span class="eyebrow" data-reveal="fade">{eyebrow}</span>

        <h2
          class="intro-split__title"
          data-text-reveal="words"
          data-heading-stagger="46"
        >
          {title}
        </h2>

        <p class="intro-split__body" data-reveal="fade-up" style="--reveal-delay:220ms">{body}</p>

        {link && (
          <a href={link.href} class="text-link mt-8" data-reveal="fade-up" style="--reveal-delay:320ms">
            {link.label} <Icon name="arrow-right" size={14} class="arrow" />
          </a>
        )}
      </div>

      <!-- ── Stats / media column ──────────────────────────────────────── -->
      <div class="intro-split__aside">
        {image ? (
          <figure class="intro-split__figure">
            <div class="media ratio-4-3" data-reveal="clip">
              <Img src={image} alt={imageCaption ?? ''} loading="lazy" width="900" height="675" />
            </div>
            {imageCaption && <figcaption class="intro-split__caption">{imageCaption}</figcaption>}
          </figure>
        ) : (
          <div class="intro-split__stats" data-stagger="130">
            {stats.map((s) => (
              <div class="stat">
                <strong
                  class="stat__value"
                  data-counter={s.value}
                  data-counter-suffix={s.suffix ?? ''}
                  data-counter-decimals={s.decimals ?? 0}
                >0</strong>
                <span class="stat__label">{s.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .intro-split__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .intro-split__grid.is-reverse { grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr); }
  .intro-split__grid.is-reverse .intro-split__text { order: 2; }
  .intro-split__grid.is-reverse .intro-split__aside { order: 1; }

  .intro-split__title {
    margin-top: 1.5rem;
    font-size: clamp(1.85rem, 3.4vw, 2.9rem);
    line-height: 1.14;
    letter-spacing: -0.028em;
    max-width: 22ch;
  }

  .intro-split__body {
    margin-top: 1.75rem;
    max-width: 52ch;
    font-size: 1.0625rem;
    color: var(--text-soft);
  }

  /* ── Stats ─────────────────────────────────────────────────────────── */
  .intro-split__stats {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
  }

  .intro-split__stats :global(.stat) { padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .intro-split__stats :global(.stat:first-child) { border-top: 0; padding-top: 0.75rem; }

  /* ── Figure ────────────────────────────────────────────────────────── */
  .intro-split__figure { margin: 0; }

  .intro-split__caption {
    margin-top: 0.85rem;
    font-size: var(--fs-sub);
    color: var(--text-mute);
  }

  /* ── Responsive ────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .intro-split__grid,
    .intro-split__grid.is-reverse { grid-template-columns: minmax(0, 1fr); }

    .intro-split__grid.is-reverse .intro-split__text,
    .intro-split__grid.is-reverse .intro-split__aside { order: initial; }

    .intro-split__stats {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 2rem 3rem;
      border-top: 0;
    }

    .intro-split__stats :global(.stat) { border-top: 0; padding-top: 0; }
  }
</style>
