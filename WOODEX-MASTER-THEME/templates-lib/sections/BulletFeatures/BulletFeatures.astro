---
/**
 * BULLET FEATURES — "Industrial facility designs with optimal space
 * utilization" style block: a numbered/checked bullet list beside media,
 * with an optional dark statement panel and CTA.
 *
 * MOTION: heading reveal, staggered bullets, parallax media.
 */
import Icon from '../components/ui/Icon.astro';
import Img from '../components/ui/Img.astro';

interface Bullet { title: string; text: string; icon?: string }

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  bullets: Bullet[];
  image?: string;
  imageAlt?: string;
  quote?: { text: string; author?: string };
  cta?: { label: string; href: string };
  reverse?: boolean;
  variant?: 'list' | 'cards' | 'dark';
  theme?: 'default' | 'gray' | 'dark';
}

const {
  eyebrow,
  title,
  lede,
  bullets,
  image,
  imageAlt = '',
  quote,
  cta,
  reverse = false,
  variant = 'list',
  theme = 'default',
} = Astro.props;
---

<section class:list={['section', 'bf', `bf--${variant}`, reverse && 'bf--reverse']} data-theme={theme}>
  <div class="container bf__grid">
    <div class="bf__copy">
      {eyebrow && <span class="eyebrow" data-reveal="fade">{eyebrow}</span>}
      <h2 class="bf__title" data-heading-reveal="words" data-heading-stagger="44">{title}</h2>
      {lede && <p class="bf__lede" data-reveal="fade-up" style="--reveal-delay:200ms">{lede}</p>}

      <ul class="bf__list" data-stagger="90">
        {bullets.map((b, i) => (
          <li class="bf__item" data-reveal="fade-up">
            <span class="bf__marker" aria-hidden="true">
              {b.icon ? <Icon name={b.icon} size={16} stroke={1.7} /> : String(i + 1).padStart(2, '0')}
            </span>
            <div class="bf__item-body">
              <h3 class="bf__item-title">{b.title}</h3>
              <p class="bf__item-text">{b.text}</p>
            </div>
          </li>
        ))}
      </ul>

      {quote && (
        <blockquote class="bf__quote" data-reveal="fade-up">
          <p>{quote.text}</p>
          {quote.author && <cite>{quote.author}</cite>}
        </blockquote>
      )}

      {cta && (
        <a href={cta.href} class="btn btn--primary" style="margin-top:2rem" data-reveal="fade-up">
          <span class="btn__label"><span>{cta.label}</span><span>{cta.label}</span></span>
          <span class="btn__chip" aria-hidden="true"><Icon name="arrow-right" size={11} stroke={2.4} /></span>
        </a>
      )}
    </div>

    {image && (
      <div class="bf__media" data-reveal="clip">
        <Img src={image} alt={imageAlt || title} width={1200} height={1400} loading="lazy" data-parallax="0.05" />
      </div>
    )}
  </div>
</section>

<style>
  .bf__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }

  .bf--reverse .bf__grid > .bf__copy { order: 2; }

  .bf__title { margin-top: 1.25rem; font-size: clamp(1.85rem, 3.6vw, 2.9rem); line-height: 1.08; letter-spacing: -0.034em; max-width: 24ch; }
  .bf__lede { margin-top: 1.25rem; color: var(--text-soft); max-width: 54ch; }

  .bf__list { list-style: none; display: flex; flex-direction: column; gap: 1px; margin-top: clamp(1.75rem, 3vw, 2.5rem); background: var(--line); border-block: 1px solid var(--line); }

  .bf__item { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.15rem; padding: 1.35rem 0; background: inherit; }

  .bf__marker {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--text-mute);
    transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }

  .bf__item:hover .bf__marker { background: var(--c-navy); border-color: var(--c-navy); color: var(--c-cream); }

  .bf__item-title { font-size: clamp(1.05rem, 1.6vw, 1.3rem); letter-spacing: -0.022em; }
  .bf__item-text { margin-top: 0.35rem; font-size: 0.9375rem; color: var(--text-soft); max-width: 52ch; }

  .bf__quote { margin-top: 2rem; padding-inline-start: 1.5rem; border-inline-start: 2px solid var(--c-cream); }
  .bf__quote p { font-family: var(--ff-display); font-size: clamp(1.1rem, 1.9vw, 1.4rem); line-height: 1.4; letter-spacing: -0.02em; }
  .bf__quote cite { display: block; margin-top: 0.75rem; font-size: var(--fs-sub); font-style: normal; color: var(--text-mute); }

  .bf__media {
    position: relative;
    border-radius: var(--r-lg);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--bg-soft);
  }

  .bf__media :global(img) { width: 100%; height: 110%; object-fit: cover; inset-block-start: -5%; position: relative; }

  /* ── Variants ─────────────────────────────────────────────────────── */
  .bf--cards .bf__list { gap: 1rem; background: none; border: 0; }
  .bf--cards .bf__item {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 1.5rem;
  }

  .bf--dark { background: var(--c-navy); color: var(--c-cream); }
  .bf--dark :global(.eyebrow) { color: rgba(252, 242, 232, 0.5); }
  .bf--dark .bf__lede,
  .bf--dark .bf__item-text { color: rgba(252, 242, 232, 0.68); }
  .bf--dark .bf__list { background: rgba(252, 242, 232, 0.16); border-color: rgba(252, 242, 232, 0.16); }
  .bf--dark .bf__marker { border-color: rgba(252, 242, 232, 0.28); color: rgba(252, 242, 232, 0.6); }
  .bf--dark .bf__item:hover .bf__marker { background: var(--c-cream); border-color: var(--c-cream); color: var(--c-navy); }
  .bf--dark .bf__quote { border-color: var(--c-cream); }

  @media (max-width: 900px) {
    .bf__grid { grid-template-columns: minmax(0, 1fr); }
    .bf--reverse .bf__grid > .bf__copy { order: 0; }
    .bf__media { aspect-ratio: 4 / 3; }
  }
</style>
