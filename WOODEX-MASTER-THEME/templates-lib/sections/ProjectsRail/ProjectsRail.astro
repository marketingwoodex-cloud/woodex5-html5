---
/**
 * SECTION · Projects Rail                     [ projects-rail ]
 * ---------------------------------------------------------------------------
 * A horizontally scrolling project gallery driven by vertical page scroll.
 * On touch devices it degrades to a native horizontal swipe rail.
 *
 * MOTION: data-scroll-rail (vertical scroll → horizontal translate)
 * USED ON: /home-one, /home-three
 */
import Icon from '../components/ui/Icon.astro';
import { projects, featuredProjects } from '../data/projects.js';
import Img from '../components/ui/Img.astro';


interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  limit?: number;
  ctaLabel?: string;
  ctaHref?: string;
  variant?: 'light' | 'dark';
}

const {
  eyebrow = 'Our projects',
  title = 'Creating sustainable spaces for living',
  lede = 'From concept to completion we work closely with clients to deliver spaces that are functional, sustainable and beautifully made.',
  limit = 6,
  ctaLabel = 'View all projects',
  ctaHref = '/portfolio-three',
  variant = 'dark',
} = Astro.props;

const list = (featuredProjects().length >= limit ? featuredProjects() : projects).slice(0, limit);
---

<section class:list={['projects-rail', 'section']} data-theme={variant}>
  <div class="container">
    <div class="sec-head">
      <div class="sec-head__text">
        <span class="eyebrow" data-reveal="fade">{eyebrow}</span>
        <h2 data-heading-reveal="words" data-heading-stagger="50">{title}</h2>
      </div>

      <div class="sec-head__aside">
        <p data-reveal="fade-up" style="--reveal-delay:180ms">{lede}</p>
        <a href={ctaHref} class="btn btn--ghost mt-6" data-reveal="fade-up" style="--reveal-delay:280ms">
          <span class="btn__label"><span>{ctaLabel}</span></span>
          <Icon name="arrow-right" size={15} class="arrow" />
        </a>
      </div>
    </div>
  </div>

  <!-- Full-bleed rail so cards can bleed off both edges -->
  <div class="projects-rail__viewport" data-scroll-rail>
    <div class="projects-rail__track" data-scroll-rail-track>
      {list.map((p, i) => (
        <article class="pr-card" data-reveal="fade-up" style={`--reveal-delay:${i * 70}ms`}>
          <a href={`/project/${p.slug}`} class="pr-card__link" data-cursor="View project">
            <div class="pr-card__media">
              <Img src={p.cover} alt={p.title} loading="lazy" width="900" height="1150" />
              <span class="pr-card__scrim" aria-hidden="true"></span>

              <span class="pr-card__tags">
                <span class="tag">{p.sector}</span>
                <span class="tag">{p.year}</span>
              </span>

              <span class="pr-card__hover" aria-hidden="true">
                <Icon name="arrow-up-right" size={16} stroke={1.8} />
              </span>
            </div>

            <div class="pr-card__body">
              <h3 class="pr-card__title">{p.title}</h3>
              <p class="pr-card__excerpt">{p.excerpt}</p>
              <div class="pr-card__foot">
                <span><Icon name="map-pin" size={12} /> {p.location}</span>
                <span>{p.area}</span>
              </div>
            </div>
          </a>
        </article>
      ))}

      <!-- End card -->
      <article class="pr-card pr-card--end">
        <a href="/portfolio-one" class="pr-card__link pr-card__end-inner">
          <span class="pr-card__end-no">{projects.length}</span>
          <span class="pr-card__end-label">Projects in the archive</span>
          <span class="btn btn--beige">
            <span class="btn__label"><span>Browse all work</span></span>
            <span class="btn__chip" aria-hidden="true"><Icon name="arrow-right" size={11} stroke={2.4} /></span>
          </span>
        </a>
      </article>
    </div>
  </div>

  <div class="container">
    <span class="projects-rail__hint" aria-hidden="true">
      <i></i> Scroll to explore
    </span>
  </div>
</section>

<style>
  .sec-head__aside { display: flex; flex-direction: column; align-items: flex-start; }
  .sec-head__aside :global(.btn) { align-self: flex-start; }

  /* ── Rail ──────────────────────────────────────────────────────────── */
  .projects-rail__viewport {
    overflow: hidden;
    padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2));
  }

  .projects-rail__track {
    display: flex;
    gap: clamp(1rem, 2vw, 1.75rem);
    width: max-content;
    padding-block: 0.5rem;
  }

  /* On touch devices, allow native horizontal scrolling instead. */
  @media (hover: none) {
    .projects-rail__viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .projects-rail__viewport::-webkit-scrollbar { display: none; }
    .projects-rail__track { transform: none !important; }
    .pr-card { scroll-snap-align: start; }
  }

  /* ── Cards ─────────────────────────────────────────────────────────── */
  .pr-card {
    width: clamp(17rem, 26vw, 24rem);
    flex: none;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--line);
    transition: transform var(--dur-slow) var(--ease-out), border-color var(--dur) var(--ease-out);
  }

  .pr-card:hover { transform: translateY(-0.5rem); border-color: var(--line-strong); }

  .pr-card__link { display: block; height: 100%; }

  .pr-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-soft);
  }

  .pr-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-expo);
  }

  .pr-card:hover .pr-card__media img { transform: scale(1.07); }

  .pr-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.28) 0%, transparent 42%, rgba(0, 0, 0, 0.5) 100%);
  }

  .pr-card__tags {
    position: absolute;
    inset-block-start: 0.9rem;
    inset-inline-start: 0.9rem;
    display: flex;
    gap: 0.4rem;
  }

  .pr-card__tags :global(.tag) {
    background: rgba(252, 242, 232, 0.9);
    color: var(--c-jet);
    backdrop-filter: blur(6px);
    text-transform: capitalize;
    letter-spacing: 0.06em;
  }

  .pr-card__hover {
    position: absolute;
    inset-block-end: 0.9rem;
    inset-inline-end: 0.9rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--c-beige);
    color: var(--c-jet);
    opacity: 0;
    transform: scale(0.7) rotate(-30deg);
    transition: opacity var(--dur) var(--ease-out), transform var(--dur-slow) var(--ease-expo);
  }

  .pr-card:hover .pr-card__hover { opacity: 1; transform: scale(1) rotate(0deg); }

  .pr-card__body { padding: 1.25rem 1.35rem 1.4rem; }

  .pr-card__title {
    font-size: 1.2rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .pr-card__excerpt {
    margin-top: 0.6rem;
    font-size: var(--fs-sub);
    color: var(--text-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pr-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--text-mute);
  }

  .pr-card__foot span { display: inline-flex; align-items: center; gap: 0.35rem; }

  /* ── End card ──────────────────────────────────────────────────────── */
  .pr-card--end { display: grid; }

  .pr-card__end-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1rem;
    height: 100%;
    min-height: 24rem;
    padding: 2rem;
    background: var(--c-jet);
    color: var(--c-beige);
  }

  .pr-card__end-no {
    font-family: var(--ff-display);
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .pr-card__end-label {
    font-size: var(--fs-sub);
    color: rgba(252, 242, 232, 0.6);
    margin-bottom: 0.5rem;
  }

  /* ── Hint ──────────────────────────────────────────────────────────── */
  .projects-rail__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  .projects-rail__hint i {
    display: block;
    width: 3rem;
    height: 1px;
    background: currentColor;
    position: relative;
    overflow: hidden;
  }

  .projects-rail__hint i::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: -100%;
    width: 60%;
    background: var(--text);
    animation: hint-slide 2.4s var(--ease-in-out) infinite;
  }

  @keyframes hint-slide {
    0% { inset-inline-start: -60%; }
    100% { inset-inline-start: 100%; }
  }

  @media (hover: none) { .projects-rail__hint { display: none; } }
</style>
