---
/** PAGE TEMPLATE · Testimonials                [ testimonials ] */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/global/PageHeader.astro';
import TestimonialsSlider from '../sections/TestimonialsSlider.astro';
import StatsStrip from '../sections/StatsStrip.astro';
import ProjectGrid from '../sections/ProjectGrid.astro';
import ClientsMarquee from '../sections/ClientsMarquee.astro';
import CtaBand from '../sections/CtaBand.astro';
import { testimonials } from '../data/content.js';
---

<BaseLayout
  title="Client Testimonials | Woodex Interior"
  description="What homeowners, operators and developers say after a Woodex Interior project is handed over."
  overlayHeader
  current="about"
  schema={{
    '@type': 'ItemList',
    name: 'Woodex Interior client testimonials',
    itemListElement: testimonials.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: { '@type': 'Review', reviewBody: t.quote, author: { '@type': 'Person', name: t.author }, reviewRating: { '@type': 'Rating', ratingValue: t.rating, bestRating: 5 } },
    })),
  }}
>
  <PageHeader
    eyebrow="Client words"
    title="Trusted in 240+ design projects"
    lede="We do not write these. Clients say them after we hand the keys back and the snag list is empty."
    crumbs={[{ label: 'Testimonials' }]}
    variant="soft"
    meta={[
      { label: 'Average rating', value: '4.9 / 5' },
      { label: 'Reviews', value: '6 featured' },
      { label: 'Retention', value: '98%' },
      { label: 'Repeat clients', value: 'Most of our work' },
    ]}
  />

  <TestimonialsSlider variant="grid" eyebrow="Reviews" title="What clients say" theme="default" />

  <StatsStrip variant="numbers" eyebrow="The record behind the reviews" theme="dark" />

  <TestimonialsSlider variant="marquee" eyebrow="In their own words" title="Longer-form feedback" theme="gray" />

  <ClientsMarquee variant="grid" eyebrow="Who we build for" title="Clients and operators" />

  <ProjectGrid eyebrow="See the evidence" title="The projects behind the reviews" variant="grid" limit={6} showFilter={false} theme="gray" />

  <CtaBand
    eyebrow="Your turn"
    title="Let&rsquo;s give you something worth reviewing"
    primary={{ label: 'Start a project', href: '/contact-one' }}
    secondary={{ label: 'Book a consultation', href: '/contact-two' }}
    variant="split"
  />
</BaseLayout>
