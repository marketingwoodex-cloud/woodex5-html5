---
/**
 * PAGE TEMPLATE · Article                     [ blog/:slug ]
 * ---------------------------------------------------------------------------
 * Renders a journal article: hero, rich-text body with TOC, author box,
 * share row, related articles, newsletter, CTA.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHero from '../../sections/ArticleHero.astro';
import RichText from '../../sections/RichText.astro';
import JournalGrid from '../../sections/JournalGrid.astro';
import NewsletterBand from '../../sections/NewsletterBand.astro';
import CtaBand from '../../sections/CtaBand.astro';
import Icon from '../../components/ui/Icon.astro';
import Img from '../../components/ui/Img.astro';
import { articles, getArticle, relatedArticles, topics, formatDate } from '../../data/articles.js';
import { articleImage, avatarImage } from '../../data/images.js';
import { site } from '../../data/site.js';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug } }));
}

const { slug } = Astro.params;
const article = getArticle(slug);

if (!article) {
  return Astro.redirect('/journal');
}

const related = relatedArticles(slug, 3);
const topicLabel = topics.find((t) => t.id === article.topic)?.label ?? article.topic;
---

<BaseLayout
  title={`${article.title} | Woodex Journal`}
  description={article.excerpt}
  image={articleImage(slug)}
  overlayHeader
  current="journal"
  footerCta={false}
  schema={[
    {
      '@type': 'BlogPosting',
      headline: article.title,
      description: article.excerpt,
      image: [articleImage(slug)],
      datePublished: article.date,
      dateModified: article.date,
      author: { '@type': 'Person', name: article.author, jobTitle: article.authorRole },
      publisher: { '@type': 'Organization', name: site.name },
      keywords: article.tags.join(', '),
      articleSection: topicLabel,
      wordCount: article.body.reduce((acc, b) => acc + (b.text?.length ?? 0) + (b.items?.join(' ').length ?? 0), 0) / 5,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
        { '@type': 'ListItem', position: 2, name: 'Journal', item: '/journal' },
        { '@type': 'ListItem', position: 3, name: article.title, item: `/blog/${slug}` },
      ],
    },
  ]}
>
  <ArticleHero
    title={article.title}
    excerpt={article.excerpt}
    topic={article.topic}
    date={article.date}
    readingTime={article.readingTime}
    author={article.author}
    authorRole={article.authorRole}
    cover={articleImage(slug)}
    tags={article.tags}
  />

  <RichText blocks={article.body} showToc narrow />

  <!-- ══ Tags + author ════════════════════════════════════════════════ -->
  <section class="section section--sm ba__meta-sec">
    <div class="container">
      <div class="ba__meta">
        <div class="ba__tags">
          <span class="ba__tags-label">Tagged</span>
          {article.tags.map((t) => <a href={`/journal?topic=${article.topic}`} class="tag">{t}</a>)}
        </div>

        <div class="ba__share">
          <span class="ba__tags-label">Share</span>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn">
            <Icon name="linkedin" size={14} />
          </a>
          <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener" aria-label="Share on X">
            <Icon name="x" size={14} />
          </a>
          <a href={`mailto:?subject=${encodeURIComponent(article.title)}&body=${encodeURIComponent(Astro.url.href)}`} aria-label="Share by email">
            <Icon name="mail" size={14} />
          </a>
          <button type="button" data-copy={Astro.url.href} data-copy-label="Copy link" data-copy-done="Copied">
            Copy link
          </button>
        </div>
      </div>

      <!-- Author box -->
      <aside class="ba__author" data-reveal="fade-up">
        <Img src={avatarImage(0)} alt={article.author} width={96} height={96} loading="lazy" />

        <div class="ba__author-body">
          <span class="ba__author-role">{article.authorRole}</span>
          <strong class="ba__author-name">{article.author}</strong>
          <p class="ba__author-bio">
            Writes about interior delivery, documentation and material specification in Pakistan.
            Part of the Woodex design and delivery team.
          </p>
          <a href="/about" class="text-link" style="margin-top:1rem">More about the studio <Icon name="arrow-right" size={13} class="arrow" /></a>
        </div>
      </aside>
    </div>
  </section>

  <JournalGrid
    eyebrow="Keep reading"
    title="Related articles"
    variant="grid"
    limit={3}
    showFilter={false}
    ctaLabel="All articles"
    theme="gray"
  />

  <NewsletterBand variant="band" theme="default" />

  <CtaBand
    eyebrow="Work with us"
    title="Ready to apply any of this to your own space?"
    primary={{ label: 'Start a project', href: '/contact-one' }}
    secondary={{ label: 'See our work', href: '/portfolio-one' }}
    variant="split"
  />
</BaseLayout>

<style>
  .ba__meta-sec { border-block-start: 1px solid var(--line); }

  .ba__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .ba__tags, .ba__share { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }

  .ba__tags-label {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  .ba__share a, .ba__share button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.25rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    font-size: 0.75rem;
    color: var(--text-soft);
    transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }

  .ba__share a { width: 2.25rem; padding-inline: 0; justify-content: center; }

  .ba__share a:hover, .ba__share button:hover {
    background: var(--c-jet);
    border-color: var(--c-jet);
    color: var(--c-beige);
  }

  /* ── Author box ────────────────────────────────────────────────────── */
  .ba__author {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
    margin-top: 2.5rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg-soft);
  }

  .ba__author :global(img) {
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .ba__author-body { display: flex; flex-direction: column; gap: 0.4rem; }

  .ba__author-role { font-size: 0.625rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .ba__author-name { font-family: var(--ff-display); font-size: 1.35rem; font-weight: 500; letter-spacing: -0.022em; }
  .ba__author-bio { font-size: 0.9375rem; color: var(--text-soft); max-width: 56ch; }

  @media (max-width: 620px) {
    .ba__author { grid-template-columns: minmax(0, 1fr); }
  }
</style>
